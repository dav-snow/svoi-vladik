# HTTPS-прокси перед API. Домен и email приходят из окружения контейнера
# (.env -> docker-compose.prod.yml); реальных доменов в репозитории нет.
# Сертификат Let's Encrypt Caddy получает и продлевает сам: для этого
# A-запись домена должна указывать на сервер, а порт 80 быть открыт.
{
	email {$ACME_EMAIL}
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 2m
		}
	}
}

{$DOMAIN} {
	encode zstd gzip

	# Остальные заголовки безопасности отдаёт приложение. HSTS возможен только
	# на HTTPS-сайте; Server убираем, чтобы не подсказывать версию upstream.
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy api:8000
}
